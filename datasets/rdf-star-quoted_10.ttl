@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix adms:  <http://www.w3.org/ns/adms#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix :      <http://example.org/ns#> . 

<Dist1> a dcat:Distribution .

<Dist1> dct:format <csv> .

<< <Dist1> dct:format <csv> >>
    dct:source <DMP> ;
    adms:status "planned" .
<Dist1> a dcat:Distribution .

<Dist1> dct:format <xls> .

<< <Dist1> dct:format <xls> >>
    dct:source <DMP> ;
    adms:status "planned" .
<Dist2> a dcat:Distribution .

<Dist2> dct:format <json> .

<< <Dist2> dct:format <json> >>
    dct:source <DMP> ;
    adms:status "planned" .
<Dist2> a dcat:Distribution .

<Dist2> dct:format <ttl> .

<< <Dist2> dct:format <ttl> >>
    dct:source <DMP> ;
    adms:status "planned" .
<Dist3> a dcat:Distribution .

<Dist3> dct:format <rdf> .

<< <Dist3> dct:format <rdf> >>
    dct:source <DMP> ;
    adms:status "planned" .
<Dist3> a dcat:Distribution .

<Dist3> dct:format <txt> .

<< <Dist3> dct:format <txt> >>
    dct:source <DMP> ;
    adms:status "planned" .
<Dist4> a dcat:Distribution .

<Dist4> dct:format <xml> .

<< <Dist4> dct:format <xml> >>
    dct:source <DMP> ;
    adms:status "planned" .
<Dist4> a dcat:Distribution .

<Dist4> dct:format <csv> .

<< <Dist4> dct:format <csv> >>
    dct:source <DMP> ;
    adms:status "planned" .
<Dist5> a dcat:Distribution .

<Dist5> dct:format <xls> .

<< <Dist5> dct:format <xls> >>
    dct:source <DMP> ;
    adms:status "planned" .
<Dist5> a dcat:Distribution .

<Dist5> dct:format <json> .

<< <Dist5> dct:format <json> >>
    dct:source <DMP> ;
    adms:status "planned" .
