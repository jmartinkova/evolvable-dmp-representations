id:DMPStandard a dct:Standard ;
    dct:title "Horizon Europe Template"@en .

id:V1 a dmp:DMPVersion ;
    dmp:versionOf id:DMP .

id:attributionCreator a prov:Attribution .

id:attributionDataManager a prov:Attribution .

id:attributionInvestigator a prov:Attribution .

id:attributionProjectAdministrator a prov:Attribution .

id:cc a dct:LicenseDocument ;
    dct:identifier <https://creativecommons.org/licenses/by/4.0/> .

id:concept1OfDataset a skos:Concept ;
    dct:description "psychological"@en .

id:concept2OfDataset a skos:Concept ;
    dct:description "lay people’s and philosophers’ susceptibility"@en .

id:concept3OfDataset a skos:Concept ;
    dct:description " Demographic data "@en .

id:dataIdentifier a datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:doi .

id:dataProvenance a dct:ProvenanceStatement ;
    dct:description "Most of the project’s empirical studies will be designed in Qualtrics, an online survey software. Participants of the studies will be recruited from online crowdsourcing pools such as Prolific Academic, mostly in the US. For their time and effort all participants will be compensated at an hourly rate that is above the national minimal income."@en .

id:dataProvenanceStandard a dct:Standard ;
    dct:description "the common standards in psychology and experimental philosophy, i.e., studies will be reported in a journal article which involves a dedicated “Participants” section, specifying how participants were recruited, what number of participants were recruited, why this number of participants was recruited, who the participants were (demographic data), etc."@en .

id:dataset a schema11:Thing,
        dcat:Dataset ;
    dct:description "The data may include qualified references to other data that has been collected in the project. If this is the case (for example, if follow-up studies are conducted to be better able to evaluate explanations of data or cross-cultural research is conducted to test previous findings’ generalizability across different countries) then the scientific links between the datasets will be described on OSF as well as in the resulting pre-prints and journal articles."@en .

id:datasetAccessProtocol a schema11:EntryPoint .

id:datasetAccessibility a dmp:Access .

id:datasetAvailability a dmp:Availability .

id:datasetAvailabilityDuration a dct:PeriodOfTime ;
    dmp:minimumDuration "At least ten years"@en .

id:datasetEmbargo a dmp:Embargo .

id:datasetInformedConsent a dmp:InformedConsent ;
    dct:description "Yes, each study will involve a consent page. Participants will be asked to agree to the following claims before they can complete the studies: I agree that my personal data (including demographic information), which is collected anonymously during this study, is processed by the University of Graz by means of statistical data analysis for research purposes and used to publish scientific papers. I agree that my anonymized data will be made available in open databases (e.g. in the Open Science Framework; https://osf.io/) indefinitely for the purpose of scientific transparency. I can withdraw my consent to the processing of my data at any time by writing to Dr. Thomas Pölzler, thomas.poelzler@uni-graz.at, University of Graz, Attemsgasse 25/II, 8010 Graz. The revocation does not affect the legality of the data processed until the revocation. I have read the above instructions and I agree to participate. I know that I can cancel my participation at any time without giving reasons"@en .

id:datasetPreservation a dmp:Preservation .

id:datasetPreservationDuration a dct:PeriodOfTime ;
    dmp:minimumDuration "At least ten years"@en .

id:datasetSecurityPrivacy a dcso:SecurityPrivacy ;
    dct:description "  If the project collects sensitive data then this data will be sufficiently anonymized before being uploaded to OSF. The original sensitive data, stored on the USB flash drive, will be password protected. It can only be accessed by the project leader and co-authors who have collaborated in generating and analysing the data."@en .

id:distribution a dcat:Distribution .

id:fairDataCost a schema11:MonetaryAmount ;
    sioc:topic id:makingDataFAIR ;
    schema11:value 0 .

id:formatOfDistribution1 a dct:MediaTypeOrExtent ;
    dct:abbreviation "xls"@en .

id:formatOfDistribution2 a dct:MediaTypeOrExtent ;
    dct:abbreviation "csv"@en .

id:formatOfMetadataDocument a dct:MediaTypeOrExtent ;
    dct:abbreviation "JSON"@en ;
    dct:title "JavaScript Object Notation"@en .

id:grant a schema11:Grant ;
    dct:identifier "101105332 "@en ;
    schema11:funder id:funder .

id:indexingSoftware a schema11:SoftwareApplication ;
    dct:description "search engines such as Google"@en .

id:metadata a fabio:Metadata .

id:metadataAccessibility a dmp:Access .

id:metadataAvailability a dmp:Availability .

id:metadataAvailabilityDuration a dct:PeriodOfTime ;
    dmp:minimumDuration "At least ten years"@en .

id:metadataDocument a fabio:MetadataDocument ;
    dmp:containsMetadataElement "Date created"@en,
        "Date modified"@en,
        "Date registered"@en,
        "Resource language"@en,
        "Resource type"@en,
        "Study Description"@en,
        "Subjects"@en,
        "Tags"@en,
        "abstract "@en,
        "author names"@en,
        "keywords"@en,
        "title"@en .

id:metadataEntryPoint a schema11:EntryPoint ;
    dct:description "Each study will be pre-registered on OSF. The pre-registration will provide detailed information about the studies’ experimental design, analyses, rules for excluding participants, etc. In shortened form, much of this information will be included in the resulting pre-prints and journal articles as well. Finally, I will upload all questionnaires in full (in the form of qualtrics-generated pdfs) on OSF to allow other researchers to check and potentially re-use the studies’ materials, such as specific vignettes and questions."@en .

id:metadataIdentifier a datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:doi .

id:methodologyStandard a dct:Standard ;
    dct:description " inferential statistics, deductive and inductive arguments, etc."@en .

id:osf a dcat:DataService ;
    dct:abbreviation "OSF"@en ;
    dct:identifier <https://osf.io/> .

id:person-0000-0002-4311-0897 a foaf:Person ;
    dct:identifier <https://orcid.org/0000-0002-4311-0897> .

id:preservationDataCost a schema11:MonetaryAmount ;
    sioc:topic id:preservationData ;
    schema11:value 0 .

id:project a schema11:Project,
        prov:Entity,
        foaf:Project .

id:projectDuration a dct:PeriodOfTime ;
    dct:endDate "04-10-2026"@en ;
    dct:startDate "05-10-2023"@en .

id:projectObjective1 a rdfs:Resource ;
    dct:description "How robust is the VOI (i.e., to what extent are the judgments people arrive at by engaging in the thought experiment (easily or overly) influenced by irrelevant factors) "@en .

id:projectObjective2 a rdfs:Resource ;
    dct:description " How effective is the VOI (i.e., to what extent does it fulfill the (epistemic or illustrative) function it was supposed to fulfill)"@en .

id:projectObjective3 a rdfs:Resource ;
    dct:description " What are the larger philosophical implications of the project’s findings of about the robustness and effectivity of the VOI"@en .

id:projectRights a dct:RightsStatement ;
    dct:description "The above plan creator(s) have agreed that others may use as much of the text of this plan  as they would like in their own plans, and customise it as necessary. You do not need to credit the creator(s) as the source of the language used, but using any of the plan's text does not imply that the creator(s) endorse, or have any relationship to, your project or proposal"@en .

id:research a schema11:Action .

id:usableForWho a rdfs:Resource ;
    dct:description "The veil of ignorance thought experiment has been highly prominent in philosophy, at least since Rawls’ publication of A Theory of Justice in 1971, and has recently also been increasingly investigated by empirical researchers, such as experimental economists and psychologists. I therefore expect that the generated data will be of high usefulness outside of the project. In particular, it will be useful to philosophers who have worked on or with the veil of ignorance thought experiment (it will provide information on whether and how the thought experiment may be justifiably employed in philosophical argumentation) and to empirical scientists interested in moral cognition and decision-making (it will provide information of the thought experiment’s reliability and effectiveness)."@en .

