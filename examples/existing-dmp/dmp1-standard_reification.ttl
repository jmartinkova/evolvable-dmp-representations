id:S048 a rdf:Statement ;
    rdf:subject id:dataset ;
    rdf:predicate dcso:backupType ;
    rdf:object "In addition to being stored in OSF, all data will also be stored on a USB flash drive that will be managed by the project leader at the location at which the research currently takes place (Tokyo, Oxford, Wellington or Graz). After the end of the project the flash drive will be stored at the Department of Philosophy of the University of Graz."@en ;
    dct:source id:DMP .

id:S048_V1 a dmp:StatementInclusion ;
    dmp:statement id:S048 ;
    dmp:version id:V1 ;
    adms:status dmp:Planned .


