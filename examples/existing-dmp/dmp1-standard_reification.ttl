id:makingDataFAIR a rdfs:Resource ;
    dct:description " making data or other research outputs FAIR"@en .

id:preservationData a rdfs:Resource ;
    dct:description "preservation Data"@en .

datacite:doi a datacite:ResourceIdentifierScheme .



