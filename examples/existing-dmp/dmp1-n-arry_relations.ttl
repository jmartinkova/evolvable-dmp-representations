id:S003 a nr:Title_18250c8eRelation ;
    dct:source id:DMP ;
    nr:title_18250c8eValue " Making Morality Impartial: An Experimental Investigation of the Veil of ignorance "@en .

id:S004 a nr:QualifiedAttribution_1c81c873Relation ;
