# Notation3 quoted formulae; no separate Statement IRIs in the data.
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dmp: <https://example.org/dmp-vocab/> .
@prefix ex: <https://example.org/example/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

dmp:Completed a skos:Concept ;
    skos:prefLabel "Completed"@en .

dmp:Deprecated a skos:Concept ;
    skos:prefLabel "Deprecated"@en .

dmp:Planned a skos:Concept ;
    skos:prefLabel "Planned"@en .

# DMP and its first version
ex:DMP a dmp:DMP .

ex:V1 a dmp:DMPVersion ;
    dmp:versionOf ex:DMP .

# Dataset described by the Statements
ex:images a dcat:Dataset ;
    dcterms:title "Microscopy images" .

# S1: Deposition in the BioImage Archive
{ <https://example.org/example/images> <https://example.org/dmp-vocab/depositedIn> <https://www.ebi.ac.uk/bioimage-archive/> . }
    <http://purl.org/dc/terms/source> <https://example.org/example/DMP> ;
    is <https://example.org/dmp-vocab/statement> of <https://example.org/example/S1_V1> .

# S2: Release under CC BY 4.0
{ <https://example.org/example/images> <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> . }
    <http://purl.org/dc/terms/source> <https://example.org/example/DMP> ;
    is <https://example.org/dmp-vocab/statement> of <https://example.org/example/S2_V1> .

# S3: No human or sensitive data
{ <https://example.org/example/images> <https://example.org/dmp-vocab/containsHumanOrSensitiveData> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> . }
    <http://purl.org/dc/terms/source> <https://example.org/example/DMP> ;
    is <https://example.org/dmp-vocab/statement> of <https://example.org/example/S3_V1> .
# V1 records

ex:S1_V1 a dmp:StatementInclusion ;
    adms:status dmp:Planned ;
    dmp:version ex:V1 .

ex:S2_V1 a dmp:StatementInclusion ;
    adms:status dmp:Planned ;
    dmp:version ex:V1 .

ex:S3_V1 a dmp:StatementInclusion ;
    dmp:version ex:V1 .