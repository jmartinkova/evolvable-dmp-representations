@prefix ex: <https://example.org/example/> .
@prefix dmp: <https://example.org/dmp-vocab/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dmp:Completed rdf:type skos:Concept .
dmp:Completed skos:prefLabel "Completed"@en .
dmp:Deprecated rdf:type skos:Concept .
dmp:Deprecated skos:prefLabel "Deprecated"@en .
dmp:Planned rdf:type skos:Concept .
dmp:Planned skos:prefLabel "Planned"@en .

# DMP and its first version
ex:DMP rdf:type dmp:DMP .
ex:V1 rdf:type dmp:DMPVersion .
ex:V1 dmp:versionOf ex:DMP .

# Dataset described by the Statements
ex:images dct:title "Microscopy images" .
ex:images rdf:type dcat:Dataset .

# S1: Deposition in the BioImage Archive
ex:S1 dct:source ex:DMP ;
    rdf:type dmp:Statement ;
    rdf:reifies <<( ex:images dmp:depositedIn <https://www.ebi.ac.uk/bioimage-archive/> )>> .

# S2: Release under CC BY 4.0
ex:S2 dct:source ex:DMP ;
    rdf:type dmp:Statement ;
    rdf:reifies <<( ex:images dct:license <https://creativecommons.org/licenses/by/4.0/> )>> .

# S3: No human or sensitive data
ex:S3 dct:source ex:DMP ;
    rdf:type dmp:Statement ;
    rdf:reifies <<( ex:images dmp:containsHumanOrSensitiveData "false"^^xsd:boolean )>> .

# V1 records
ex:S1_V1 rdf:type dmp:StatementInclusion ;
    adms:status dmp:Planned ;
    dmp:statement ex:S1 ;
    dmp:version ex:V1 .

ex:S2_V1 rdf:type dmp:StatementInclusion ;
    adms:status dmp:Planned ;
    dmp:statement ex:S2 ;
    dmp:version ex:V1 .

ex:S3_V1 rdf:type dmp:StatementInclusion ;
    dmp:statement ex:S3 ;
    dmp:version ex:V1 .
