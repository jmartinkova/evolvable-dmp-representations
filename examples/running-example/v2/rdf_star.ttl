@prefix ex: <https://example.org/example/> .
@prefix dmp: <https://example.org/dmp-vocab/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dmp:Completed rdf:type skos:Concept ;
    skos:prefLabel "Completed"@en .
dmp:Deprecated rdf:type skos:Concept ;
    skos:prefLabel "Deprecated"@en .
dmp:Planned rdf:type skos:Concept ;
    skos:prefLabel "Planned"@en .

# DMP and both versions
ex:DMP rdf:type dmp:DMP .
ex:V1 rdf:type dmp:DMPVersion ;
    dmp:versionOf ex:DMP .
ex:V2 rdf:type dmp:DMPVersion ;
    dmp:versionOf ex:DMP ;
    dmp:previousVersion ex:V1 .

# Resources described by the Statements
ex:images rdf:type dcat:Dataset ;
    dct:title "Microscopy images" .

ex:localCopy rdf:type dcat:Distribution ;
    dmp:copyOf ex:images .

# S1: Content unchanged across versions
<<ex:images dmp:depositedIn <https://www.ebi.ac.uk/bioimage-archive/>>> dct:source ex:DMP .

# S2: Original licensing plan, superseded by S4
<<ex:images dct:license <https://creativecommons.org/licenses/by/4.0/>>> dct:source ex:DMP .
<<ex:images dct:license <https://creativecommons.org/licenses/by/4.0/>>> rdf:type dmp:SupersededStatement .

# S3: No human or sensitive data
<<ex:images dmp:containsHumanOrSensitiveData "false"^^xsd:boolean>> dct:source ex:DMP .

# S4: New release terms, superseding S2
<<ex:images dct:license <https://creativecommons.org/publicdomain/zero/1.0/>>> dct:source ex:DMP .
<<ex:images dct:license <https://creativecommons.org/publicdomain/zero/1.0/>>> rdf:type dmp:SupersedingStatement .
<<ex:images dct:license <https://creativecommons.org/publicdomain/zero/1.0/>>> dmp:supersedes <<ex:images dct:license <https://creativecommons.org/licenses/by/4.0/>>> .
<<ex:images dmp:containsHumanOrSensitiveData "false"^^xsd:boolean>> dct:source ex:DMP .

# Illustrative external policy
<https://example.org/policies/data-retention> dct:title "Institutional research data retention policy"@en .
<https://example.org/policies/data-retention> rdf:type dmp:ExternalSource .

# S5: Retention commitment originating from the policy
<<ex:localCopy dmp:retentionPeriod "Ten years after project completion">> dct:source <https://example.org/policies/data-retention> .

# Preserved V1 records
ex:S1_V1 rdf:type dmp:StatementInclusion ;
    adms:status dmp:Planned ;
    dmp:statement <<ex:images dmp:depositedIn <https://www.ebi.ac.uk/bioimage-archive/>>> ;
    dmp:version ex:V1 .

ex:S2_V1 rdf:type dmp:StatementInclusion ;
    adms:status dmp:Planned ;
    dmp:statement <<ex:images dct:license <https://creativecommons.org/licenses/by/4.0/>>> ;
    dmp:version ex:V1 .

ex:S3_V1 rdf:type dmp:StatementInclusion ;
    dmp:statement <<ex:images dmp:containsHumanOrSensitiveData "false"^^xsd:boolean>> ;
    dmp:version ex:V1 .

# V2 records
ex:S1_V2 rdf:type dmp:StatementInclusion ;
    adms:status dmp:Completed ;
    dmp:statement <<ex:images dmp:depositedIn <https://www.ebi.ac.uk/bioimage-archive/>>> ;
    dmp:version ex:V2 .

ex:S2_V2 rdf:type dmp:StatementInclusion ;
    adms:status dmp:Deprecated ;
    dmp:statement <<ex:images dct:license <https://creativecommons.org/licenses/by/4.0/>>> ;
    dmp:version ex:V2 .

ex:S3_V2 rdf:type dmp:StatementInclusion ;
    dmp:statement <<ex:images dmp:containsHumanOrSensitiveData "false"^^xsd:boolean>> ;
    dmp:version ex:V2 .

ex:S4_V2 rdf:type dmp:StatementInclusion ;
    adms:status dmp:Completed ;
    dmp:statement <<ex:images dct:license <https://creativecommons.org/publicdomain/zero/1.0/>>> ;
    dmp:version ex:V2 .

ex:S5_V2 rdf:type dmp:StatementInclusion ;
    adms:status dmp:Planned ;
    dmp:statement <<ex:localCopy dmp:retentionPeriod "Ten years after project completion">> ;
    dmp:version ex:V2 .

