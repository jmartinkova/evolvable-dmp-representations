@prefix ex:   <https://example.org/example/> .
@prefix dmp:  <https://example.org/dmp-vocab/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

dmp:Planned a skos:Concept ; 
    skos:prefLabel "Planned"@en .
dmp:Completed a skos:Concept ; 
    skos:prefLabel "Completed"@en .
dmp:Deprecated a skos:Concept ;
    skos:prefLabel "Deprecated"@en .

# DMP and both versions
ex:DMP a dmp:DMP .

ex:V1 a dmp:DMPVersion ; 
    dmp:versionOf ex:DMP .
    
ex:V2 a dmp:DMPVersion ;
    dmp:versionOf ex:DMP ; 
    dmp:previousVersion ex:V1 .

# Resources described by the Statements
ex:images a dcat:Dataset ; 
    dct:title "Microscopy images" .

ex:localCopy a dcat:Distribution ; 
    dmp:copyOf ex:images .

# S1: Content unchanged across versions
ex:S1 {
    ex:images dmp:depositedIn <https://www.ebi.ac.uk/bioimage-archive/> .
}
ex:S1 a dmp:Statement ; 
    dct:source ex:DMP .

# S2: Original licensing plan, superseded by S4
ex:S2 {
    ex:images dct:license <https://creativecommons.org/licenses/by/4.0/> .
}
ex:S2 a dmp:Statement, dmp:SupersededStatement ; 
    dct:source ex:DMP .

# S3: No human or sensitive data
ex:S3 {
    ex:images dmp:containsHumanOrSensitiveData false .
}
ex:S3 a dmp:Statement ; 
    dct:source ex:DMP .

# S4: New release terms, superseding S2
ex:S4 {
    ex:images dct:license <https://creativecommons.org/publicdomain/zero/1.0/> .
}
ex:S4 a dmp:Statement, dmp:SupersedingStatement ;
    dct:source ex:DMP ; dmp:supersedes ex:S2 .

# Illustrative external policy
<https://example.org/policies/data-retention>
    a dmp:ExternalSource ;
    dct:title "Institutional research data retention policy"@en .

# S5: Retention commitment originating from the policy
ex:S5 {
    ex:localCopy dmp:retentionPeriod "Ten years after project completion" .
}
ex:S5 a dmp:Statement ;
    dct:source <https://example.org/policies/data-retention> .

# Preserved V1 records
ex:S1_V1 a dmp:StatementInclusion ;
    dmp:statement ex:S1 ; 
    dmp:version ex:V1 ; 
    adms:status dmp:Planned .

ex:S2_V1 a dmp:StatementInclusion ;
    dmp:statement ex:S2 ; 
    dmp:version ex:V1 ; 
    adms:status dmp:Planned .

ex:S3_V1 a dmp:StatementInclusion ;
    dmp:statement ex:S3 ; 
    dmp:version ex:V1 .

# V2 records
ex:S1_V2 a dmp:StatementInclusion ;
    dmp:statement ex:S1 ; 
    dmp:version ex:V2 ; 
    adms:status dmp:Completed .

ex:S2_V2 a dmp:StatementInclusion ;
    dmp:statement ex:S2 ; 
    dmp:version ex:V2 ; 
    adms:status dmp:Deprecated .

ex:S3_V2 a dmp:StatementInclusion ;
    dmp:statement ex:S3 ; 
    dmp:version ex:V2 .

ex:S4_V2 a dmp:StatementInclusion ;
    dmp:statement ex:S4 ; 
    dmp:version ex:V2 ; 
    adms:status dmp:Completed .

ex:S5_V2 a dmp:StatementInclusion ;
    dmp:statement ex:S5 ; 
    dmp:version ex:V2 ; 
    adms:status dmp:Planned .
