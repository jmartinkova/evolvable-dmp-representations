PREFIX ex: <https://example.org/example/>
PREFIX dmp: <https://example.org/dmp-vocab/>
PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT DISTINCT ?subject ?predicate ?object ?supersededSubject ?supersededPredicate ?supersededObject WHERE { ?statement dmp:supersedes ?supersededStatement 
 BIND(SUBJECT(?statement) AS ?subject)
 BIND(PREDICATE(?statement) AS ?predicate)
 BIND(OBJECT(?statement) AS ?object)
 BIND(SUBJECT(?supersededStatement) AS ?supersededSubject)
 BIND(PREDICATE(?supersededStatement) AS ?supersededPredicate)
 BIND(OBJECT(?supersededStatement) AS ?supersededObject)
}
