PREFIX ex: <https://example.org/example/>
PREFIX dmp: <https://example.org/dmp-vocab/>
PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT DISTINCT ?subject ?predicate ?object ?source WHERE { ?i a dmp:StatementInclusion; dmp:version ex:V2; dmp:statement ?statement . ?statement dct:source ?source . ?source a dmp:ExternalSource 
 BIND(SUBJECT(?statement) AS ?subject)
 BIND(PREDICATE(?statement) AS ?predicate)
 BIND(OBJECT(?statement) AS ?object)
}
