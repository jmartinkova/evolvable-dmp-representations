PREFIX ex:   <https://example.org/example/>
PREFIX dmp:  <https://example.org/dmp-vocab/>
PREFIX adms: <http://www.w3.org/ns/adms#>

SELECT ?statement ?state
WHERE {
    ?inclusion a dmp:StatementInclusion ;
        dmp:version ex:V2 ;
        dmp:statement ?statement ;
        adms:status ?state .

    VALUES ?state {
        dmp:Planned
        dmp:Completed
        dmp:Undefined
    }
}
ORDER BY ?statement