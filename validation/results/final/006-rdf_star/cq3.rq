PREFIX ex: <https://example.org/example/>
PREFIX dmp: <https://example.org/dmp-vocab/>
PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?subject ?predicate ?object ?stateV1 ?stateV2 WHERE { ?i1 a dmp:StatementInclusion; dmp:version ex:V1; dmp:statement ?statement . ?i2 a dmp:StatementInclusion; dmp:version ex:V2; dmp:statement ?statement . OPTIONAL { ?i1 adms:status ?stateV1 } OPTIONAL { ?i2 adms:status ?stateV2 } 
 BIND(SUBJECT(?statement) AS ?subject)
 BIND(PREDICATE(?statement) AS ?predicate)
 BIND(OBJECT(?statement) AS ?object)
}
