ex:DMP a dmp:DMP .
ex:V1 a dmp:DMPVersion ;
    dmp:versionOf ex:DMP .
dmp:Planned a skos:Concept ;
    skos:prefLabel "Planned"@en .

<https://example.org/benchmark/dataset/1> a dcat:Dataset ;
