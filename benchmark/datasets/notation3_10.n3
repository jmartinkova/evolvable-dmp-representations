@prefix ex:   <https://example.org/example/> .
@prefix dmp:  <https://example.org/dmp-vocab/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

ex:DMP a dmp:DMP .
ex:V1 a dmp:DMPVersion ;
    dmp:versionOf ex:DMP .
dmp:Planned a skos:Concept ;
    skos:prefLabel "Planned"@en .

<https://example.org/benchmark/dataset/1> a dcat:Dataset .

{ <https://example.org/benchmark/dataset/1> dct:license <https://creativecommons.org/licenses/by/4.0/> . }
    dct:source ex:DMP ;
    is dmp:statement of <https://example.org/benchmark/inclusion/1> .

<https://example.org/benchmark/inclusion/1> a dmp:StatementInclusion ;
    dmp:version ex:V1 ;
    adms:status dmp:Planned .

